SUPABASE_JDBC_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=<database-username>
SUPABASE_DB_PASSWORD=<database-password>

# Used only by compose.yaml for the local PostgreSQL container
POSTGRES_DB=lostnfound
POSTGRES_USER=lostnfound
POSTGRES_PASSWORD=<choose-a-local-password>
